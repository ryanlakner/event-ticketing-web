# Copy to .env.local (git-ignored) and fill in ONE of the sign-in options below.
# With neither, the app still runs in browse-only mode.

# --- Option A: local development without Entra ID ------------------------------------
# Tokens the API accepts in Development, created in the event-ticketing-api checkout with:
#   dotnet user-jwts create --project Ticketing.Api --name organizer@example.com --role Organizer --output token
#   dotnet user-jwts create --project Ticketing.Api --name customer@example.com --role Customer --output token
VITE_DEV_ORGANIZER_TOKEN=
VITE_DEV_CUSTOMER_TOKEN=

# --- Option B: Entra ID sign-in ----------------------------------------------------------
# Printed by event-ticketing-api's infra/bootstrap/configure-github.sh for each environment.
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_API_SCOPE=

# --- API location ------------------------------------------------------------------------
# Leave empty locally: `npm run dev` proxies /api to http://localhost:5084 (override the
# target with API_PROXY_TARGET). Set it for deployed builds, e.g. https://app-ticketing-dev-api.azurewebsites.net
VITE_API_BASE_URL=
